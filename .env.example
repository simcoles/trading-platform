# Local development defaults. These only reach the Docker containers on
# 127.0.0.1, so they are not secrets. Copy as-is: cp .env.example .env
# Never put real credentials here; .env itself is ignored by Git.

POSTGRES_USER=trading
POSTGRES_PASSWORD=trading
POSTGRES_DB=trading

# Must match the three values above. Port 5433 is the Compose mapping.
# The +psycopg part selects the psycopg 3 driver.
DATABASE_URL=postgresql+psycopg://trading:trading@localhost:5433/trading

KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
